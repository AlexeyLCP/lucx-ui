// LucX overlay on anytls-go v0.0.13 cmd/server/main.go.
// Adds -cert/-key so the panel can pass its ACME pair instead of the
// process-local self-signed certificate GenerateKeyPair always minted, and
// -fallback (see anytls-server-inbound_tcp.go.overlay), and -users-file,
// -proxy-protocol and -stats (see anytls-server-users.go.overlay).

package main

import (
	"anytls/proxy/padding"
	"anytls/util"
	"context"
	"crypto/tls"
	"flag"
	"io"
	"net"
	"os"
	"strings"
	"time"

	"github.com/sirupsen/logrus"
)

func main() {
	listen := flag.String("l", "0.0.0.0:8443", "server listen port")
	password := flag.String("p", "", "password")
	passwordFile := flag.String("password-file", "", "read password from file (0600); preferred over -p")
	paddingScheme := flag.String("padding-scheme", "", "padding-scheme")
	certFile := flag.String("cert", "", "tls certificate pem")
	keyFile := flag.String("key", "", "tls private key pem")
	fallbackAddr := flag.String("fallback", "", "on a failed login, hand the connection to this plain-TCP address (e.g. a local web site 127.0.0.1:8081), so probes see that site")
	usersFile := flag.String("users-file", "", "per-user passwords, one name:password per line (0600); re-read when it changes")
	proxyProto := flag.Bool("proxy-protocol", false, "accept a PROXY v1 header from loopback peers (an SNI gateway) and use its client address")
	statsFile := flag.String("stats", "", "write per-user traffic and client IPs to this JSON file every few seconds")
	flag.Parse()
	fallbackDest = strings.TrimSpace(*fallbackAddr)
	acceptProxyProtocol = *proxyProto

	if *passwordFile != "" {
		b, err := os.ReadFile(*passwordFile)
		if err != nil {
			logrus.Fatalln("password-file:", err)
		}
		*password = strings.TrimSpace(string(b))
	}
	if *password == "" {
		*password = strings.TrimSpace(os.Getenv("ANYTLS_PASSWORD"))
	}
	if *password == "" && *usersFile == "" {
		logrus.Fatalln("please set password")
	}
	if *paddingScheme != "" {
		if f, err := os.Open(*paddingScheme); err == nil {
			b, err := io.ReadAll(f)
			if err != nil {
				logrus.Fatalln(err)
			}
			if padding.UpdatePaddingScheme(b) {
				logrus.Infoln("loaded padding scheme file:", *paddingScheme)
			} else {
				logrus.Errorln("wrong format padding scheme file:", *paddingScheme)
			}
			f.Close()
		} else {
			logrus.Fatalln(err)
		}
	}

	logLevel, err := logrus.ParseLevel(os.Getenv("LOG_LEVEL"))
	if err != nil {
		logLevel = logrus.InfoLevel
	}
	logrus.SetLevel(logLevel)

	if err := loadUsers(*password, *usersFile); err != nil {
		logrus.Fatalln("users-file:", err)
	}
	if *usersFile != "" {
		go watchUsers(*password, *usersFile)
	}
	if *statsFile != "" {
		go writeStatsLoop(*statsFile)
	}

	logrus.Infoln("[Server]", util.ProgramVersionName)
	logrus.Infoln("[Server] Listening TCP", *listen)
	if fallbackDest != "" {
		logrus.Infoln("[Server] Fallback", fallbackDest)
	}

	listener, err := net.Listen("tcp", *listen)
	if err != nil {
		logrus.Fatalln("listen server tcp:", err)
	}

	var tlsCert *tls.Certificate
	if *certFile != "" || *keyFile != "" {
		if *certFile == "" || *keyFile == "" {
			logrus.Fatalln("both -cert and -key are required")
		}
		c, err := tls.LoadX509KeyPair(*certFile, *keyFile)
		if err != nil {
			logrus.Fatalln("load certificate:", err)
		}
		tlsCert = &c
		logrus.Infoln("[Server] TLS certificate", *certFile)
	} else {
		tlsCert, _ = util.GenerateKeyPair(time.Now, "")
		logrus.Infoln("[Server] TLS using ephemeral self-signed certificate")
	}

	tlsConfig := &tls.Config{
		GetCertificate: func(chi *tls.ClientHelloInfo) (*tls.Certificate, error) {
			return tlsCert, nil
		},
	}

	ctx := context.Background()
	server := NewMyServer(tlsConfig)

	for {
		c, err := listener.Accept()
		if err != nil {
			logrus.Fatalln("accept:", err)
		}
		go handleTcpConnection(ctx, c, server)
	}
}
