{
  "id": "event-logger",
  "name": "Event logger",
  "version": "0.1.0",
  "apiVersion": 1,
  "type": "sidecar",
  "entrypoint": "event-logger",
  "architectures": ["amd64"],
  "resources": { "maxCPUPercent": 10 },
  "events": [
    "cpu.high",
    "memory.high",
    "xray.crash",
    "outbound.down",
    "outbound.up",
    "login.attempt"
  ]
}
